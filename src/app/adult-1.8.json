{
  "name": "Sample Visit Form",
  "uuid": "a1b2c3d4-0000-0000-0000-000000000000",
  "version": "1.0",
  "processor": "EncounterFormProcessor",
  "encounterType": "e22e39fd-7db2-45e7-80f1-60fa0d5a4378",
  "pages": [
    {
      "label": "Visit Details",
      "sections": [
        {
          "label": "Encounter Details",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Visit date",
              "type": "encounterDatetime",
              "id": "encDate",
              "required": "true",
              "questionOptions": { "rendering": "date" },
              "validators": [{ "type": "date", "allowFutureDates": "false" }]
            },
            {
              "label": "Provider",
              "type": "encounterProvider",
              "id": "provider",
              "questionOptions": { "rendering": "ui-select-extended" }
            },
            {
              "label": "Facility",
              "type": "encounterLocation",
              "id": "location",
              "questionOptions": { "rendering": "ui-select-extended" }
            },
            {
              "label": "Perform mental health screening?",
              "id": "doMentalHealth",
              "type": "obs",
              "questionOptions": {
                "concept": "f7c3f7a0-0000-4000-8000-000000000001",
                "rendering": "select",
                "answers": [
                  { "concept": "a899b35c-1350-11df-a1f1-0026b9348838", "label": "Yes" },
                  { "concept": "a899b42e-1350-11df-a1f1-0026b9348838", "label": "No" }
                ]
              }
            }
          ]
        },
        {
          "label": "ART Status",
          "isExpanded": "true",
          "questions": [
            {
              "label": "Patient currently on ART:",
              "id": "onArt",
              "type": "obs",
              "required": "true",
              "questionOptions": {
                "concept": "a89ae254-1350-11df-a1f1-0026b9348838",
                "rendering": "select",
                "answers": [
                  { "concept": "a899b35c-1350-11df-a1f1-0026b9348838", "label": "Yes" },
                  { "concept": "a899b42e-1350-11df-a1f1-0026b9348838", "label": "No" }
                ]
              }
            },
            {
              "label": "ART start date:",
              "id": "startDate",
              "type": "obs",
              "questionOptions": {
                "concept": "a89d200a-1350-11df-a1f1-0026b9348838",
                "rendering": "date"
              },
              "validators": [{ "type": "date" }],
              "hide": {
                "hideWhenExpression": "onArt !== 'a899b35c-1350-11df-a1f1-0026b9348838'"
              }
            },
            {
              "type": "obsGroup",
              "label": "ART adherence",
              "questionOptions": {
                "concept": "bc3834dd-ef07-4027-be30-729baa069291",
                "rendering": "group"
              },
              "questions": [
                {
                  "label": "Adherence on ART:",
                  "id": "artAdherence",
                  "type": "obs",
                  "questionOptions": {
                    "concept": "2c363a0e-7cf9-42cd-9778-1301b09c4484",
                    "rendering": "select",
                    "answers": [
                      { "concept": "a8b0f882-1350-11df-a1f1-0026b9348838", "label": "Good" },
                      { "concept": "fdaf8b47-ea14-4d28-80fa-e1da58a30e8b", "label": "Poor" }
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "label": "ARV-only questions",
          "isExpanded": "true",
          "hide": {
            "hideWhenExpression": "onArt !== 'a899b35c-1350-11df-a1f1-0026b9348838'"
          },
          "questions": [
            {
              "label": "Weeks on treatment:",
              "id": "weeksOnArt",
              "type": "obs",
              "required": "true",
              "questionOptions": {
                "concept": "a89add22-1350-11df-a1f1-0026b9348838",
                "rendering": "number",
                "min": "0",
                "max": "520"
              }
            }
          ]
        }
      ]
    },
    {
      "isSubform": true,
      "hide": {
        "hideWhenExpression": "onArt !== 'a899b35c-1350-11df-a1f1-0026b9348838'"
      },
      "subform": {
        "name": "Vital Signs Assessment",
        "package": "clinical",
        "form": {
          "name": "Vital Signs Assessment",
          "uuid": "bb430e49-1696-47eb-a33a-fbfc49edc3fd",
          "version": "1.0",
          "processor": "EncounterFormProcessor",
          "encounterType": "67a71486-1a54-468f-ac3e-7091a9a79584",
          "description": "Sample subform with validation examples",
          "pages": [
            {
              "label": "Vital Signs",
              "sections": [
                {
                  "label": "Basic Measurements",
                  "isExpanded": "true",
                  "questions": [
                    {
                      "label": "Date vitals taken",
                      "type": "obs",
                      "id": "vitalsDate",
                      "questionOptions": {
                        "concept": "163137AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                        "rendering": "date"
                      },
                      "validators": [
                        { "type": "date", "allowFutureDates": "false" },
                        {
                          "type": "js_expression",
                          "failsWhenExpression": "(new moment(encDate)).isBefore((new moment(myValue)), 'day')",
                          "message": "Vitals date cannot be after the visit date."
                        }
                      ]
                    },
                    {
                      "label": "Blood Pressure",
                      "type": "obsGroup",
                      "id": "vitals_bp_group",
                      "questionOptions": {
                        "rendering": "group",
                        "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
                      },
                      "questions": [
                        {
                          "label": "Systolic",
                          "type": "obs",
                          "id": "vitals_systolic",
                          "required": "true",
                          "questionOptions": {
                            "rendering": "number",
                            "concept": "5085AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                            "min": "50",
                            "max": "300"
                          },
                          "validators": [
                            {
                              "type": "js_expression",
                              "failsWhenExpression": "!isEmpty(vitals_diastolic) && !isEmpty(myValue) && +myValue <= +vitals_diastolic",
                              "message": "Systolic must be greater than diastolic."
                            }
                          ]
                        },
                        {
                          "label": "Diastolic",
                          "type": "obs",
                          "id": "vitals_diastolic",
                          "required": "true",
                          "questionOptions": {
                            "rendering": "number",
                            "concept": "5086AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                            "min": "30",
                            "max": "200"
                          }
                        }
                      ]
                    },
                    {
                      "label": "Heart Rate (bpm)",
                      "type": "obs",
                      "id": "vitals_heart_rate",
                      "questionOptions": {
                        "rendering": "number",
                        "concept": "5087AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                        "min": "30",
                        "max": "220"
                      }
                    },
                    {
                      "label": "Temperature (°C)",
                      "type": "obs",
                      "id": "vitals_temperature",
                      "questionOptions": {
                        "rendering": "number",
                        "concept": "5088AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                        "min": "35",
                        "max": "42"
                      },
                      "validators": [
                        {
                          "type": "js_expression",
                          "failsWhenExpression": "!isEmpty(myValue) && +myValue >= 38",
                          "message": "Temperature is 38°C or above — consider fever documentation."
                        }
                      ]
                    },
                    {
                      "label": "Clinical notes",
                      "type": "obs",
                      "id": "vitals_notes",
                      "questionOptions": {
                        "rendering": "textarea",
                        "concept": "160531AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                        "maxLength": "500"
                      },
                      "validators": [
                        {
                          "type": "js_expression",
                          "failsWhenExpression": "!isEmpty(vitals_temperature) && +vitals_temperature >= 38 && isEmpty(myValue)",
                          "message": "Notes are required when temperature indicates fever."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "isSubform": true,
      "hide": {
        "hideWhenExpression": "doMentalHealth !== 'a899b35c-1350-11df-a1f1-0026b9348838'"
      },
      "subform": {
        "name": "Mental Health Screening",
        "package": "clinical",
        "form": {
          "name": "Mental Health Screening",
          "uuid": "c4d9f0b2-0000-4000-8000-000000000002",
          "version": "1.0",
          "processor": "EncounterFormProcessor",
          "encounterType": "9f1b2c3d-0000-4000-8000-000000000003",
          "description": "Second subform toggled independently of the ART flow",
          "pages": [
            {
              "label": "Mental Health",
              "sections": [
                {
                  "label": "PHQ-2",
                  "isExpanded": "true",
                  "questions": [
                    {
                      "label": "Little interest or pleasure in doing things?",
                      "type": "obs",
                      "id": "mh_interest",
                      "required": "true",
                      "questionOptions": {
                        "concept": "d1e2f3a4-0000-4000-8000-000000000010",
                        "rendering": "select",
                        "answers": [
                          { "concept": "a899b35c-1350-11df-a1f1-0026b9348838", "label": "Yes" },
                          { "concept": "a899b42e-1350-11df-a1f1-0026b9348838", "label": "No" }
                        ]
                      }
                    },
                    {
                      "label": "Feeling down, depressed, or hopeless?",
                      "type": "obs",
                      "id": "mh_depressed",
                      "required": "true",
                      "questionOptions": {
                        "concept": "d1e2f3a4-0000-4000-8000-000000000011",
                        "rendering": "select",
                        "answers": [
                          { "concept": "a899b35c-1350-11df-a1f1-0026b9348838", "label": "Yes" },
                          { "concept": "a899b42e-1350-11df-a1f1-0026b9348838", "label": "No" }
                        ]
                      }
                    },
                    {
                      "label": "Follow-up notes",
                      "type": "obs",
                      "id": "mh_notes",
                      "questionOptions": {
                        "rendering": "textarea",
                        "concept": "d1e2f3a4-0000-4000-8000-000000000012",
                        "maxLength": "1000"
                      },
                      "validators": [
                        {
                          "type": "js_expression",
                          "failsWhenExpression": "(mh_interest === 'a899b35c-1350-11df-a1f1-0026b9348838' || mh_depressed === 'a899b35c-1350-11df-a1f1-0026b9348838') && isEmpty(myValue)",
                          "message": "Follow-up notes are required when either screening question is answered Yes."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
